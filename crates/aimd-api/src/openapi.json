{
  "openapi": "3.1.0",
  "info": {
    "title": "aimd HTTP",
    "description": "Context preparation HTTP API for LLM workflows",
    "version": "0.23.3"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readyz",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/blobs": {
      "post": {
        "summary": "Upload Blob",
        "operationId": "upload_blob_v1_blobs_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_blob_v1_blobs_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BlobUploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/process": {
      "post": {
        "summary": "Process",
        "operationId": "process_v1_process_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs": {
      "post": {
        "summary": "Create Job",
        "operationId": "create_job_v1_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "summary": "Get Job",
        "operationId": "get_job_v1_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Cancel Job",
        "operationId": "cancel_job_v1_jobs__job_id__delete",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}/events": {
      "get": {
        "summary": "Get Job Events",
        "operationId": "get_job_events_v1_jobs__job_id__events_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Server-sent JobEvent payloads. Use Last-Event-ID to resume after the last received sequence.",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/JobEvent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BlobUploadResponse": {
        "properties": {
          "blob_id": {
            "type": "string",
            "title": "Blob Id"
          },
          "bytes": {
            "type": "integer",
            "title": "Bytes"
          },
          "filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename"
          }
        },
        "type": "object",
        "required": [
          "blob_id",
          "bytes"
        ],
        "title": "BlobUploadResponse",
        "description": "Response returned after storing sidecar-owned blob bytes."
      },
      "Body_upload_blob_v1_blobs_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "blob_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Blob Id"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_blob_v1_blobs_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse",
        "description": "Sidecar health response."
      },
      "JobCreated": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "cancelled"
            ],
            "title": "State"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          },
          "events_url": {
            "type": "string",
            "title": "Events Url"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "state",
          "status_url",
          "events_url"
        ],
        "title": "JobCreated",
        "description": "Links returned when a job is accepted."
      },
      "JobSnapshot": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "cancelled"
            ],
            "title": "State"
          },
          "request": {
            "$ref": "#/components/schemas/ProcessRequest"
          },
          "artifact": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProcessArtifact"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "downloading",
                  "extracting",
                  "transcribing",
                  "ocr",
                  "converting",
                  "saving"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "current": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Current"
          },
          "total": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Total"
          },
          "cancellation_status": {
            "type": "string",
            "enum": [
              "none",
              "requested",
              "cancelled",
              "completed_after_request"
            ],
            "title": "Cancellation Status",
            "default": "none"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "state",
          "request",
          "created_at",
          "updated_at"
        ],
        "title": "JobSnapshot",
        "description": "Current state and terminal result of a job."
      },
      "ProcessArtifact": {
        "properties": {
          "task_type": {
            "type": "string",
            "enum": [
              "transcript",
              "convert",
              "ocr"
            ],
            "title": "Task Type",
            "description": "Processing route selected by AIMD."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Display title inferred from the source."
          },
          "markdown": {
            "type": "string",
            "title": "Markdown",
            "description": "Exact Markdown produced before context chunking."
          },
          "source_uri": {
            "type": "string",
            "title": "Source Uri",
            "description": "Original URL or canonical local file URI."
          },
          "asset_base_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Base Uri",
            "description": "Base URI for relative assets referenced by Markdown."
          },
          "platform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Platform",
            "description": "Detected source platform."
          },
          "output_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output File",
            "description": "Canonical persisted Markdown path, when requested."
          },
          "output_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Dir",
            "description": "Canonical asset-producing output directory, if any."
          }
        },
        "type": "object",
        "required": [
          "task_type",
          "title",
          "markdown",
          "source_uri"
        ],
        "title": "ProcessArtifact",
        "description": "Lossless editor artifact returned by a completed job.",
        "example": {
          "asset_base_uri": "file:///tmp/aimd-output/assets/",
          "markdown": "# Example document\n\nExact AIMD output.\n",
          "output_dir": "/tmp/aimd-output",
          "source_uri": "file:///Users/example/source.docx",
          "task_type": "convert",
          "title": "Example document"
        }
      },
      "ProcessRequest": {
        "properties": {
          "input_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Source",
            "description": "Audio/video file path, video URL, document path, image path, or scanned PDF path."
          },
          "blob_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Blob Id",
            "description": "Sidecar-owned blob identifier from POST /v1/blobs."
          },
          "task_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "transcript",
                  "convert",
                  "ocr"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Type",
            "description": "Optional explicit task: transcript, convert, or ocr. Defaults to auto-routing."
          },
          "output_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output File",
            "description": "Optional path to write resulting markdown output."
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "Model for transcription or OCR. Default OCR is unlimited-ocr (mlx-community/Unlimited-OCR-4bit on macOS, baidu/Unlimited-OCR on Linux/CUDA). macOS OCR: unlimited-ocr (default, mlx-vlm>=0.6.4) or glm-ocr, or explicit mlx-community/Unlimited-OCR-{4bit,6bit,8bit,bf16} / mlx-community/GLM-OCR-{4bit,6bit,8bit,bf16} model IDs. Linux/CUDA OCR: unlimited-ocr (default) or glm-ocr (baidu/Unlimited-OCR, zai-org/GLM-OCR). mlx ASR: qwen3-asr-1.7b (default) or qwen3-asr-0.6b combined with --precision, or explicit mlx-community/Qwen3-ASR-* model IDs. CUDA Transformers ASR: qwen3-asr-1.7b (default) or qwen3-asr-0.6b, resolving to Qwen/Qwen3-ASR-*-hf (legacy underscore aliases and Qwen/Qwen3-ASR-* IDs still work)."
          },
          "precision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precision",
            "description": "Model precision/quantization: 4bit, 6bit, 8bit, or bf16 (dash variants like 4-bit are accepted). macOS MLX backends select the matching mlx-community checkpoint (default 4bit when omitted). CUDA Transformers backends only accept bf16, and require CUDA bf16 support; quantized values are rejected. When omitted, Transformers keeps automatic dtype selection (bf16 on supported CUDA, fp16 on CUDA/MPS, fp32 on CPU)."
          },
          "asr_base_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asr Base Url",
            "description": "OpenAI-compatible remote ASR base URL."
          },
          "asr_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asr Model",
            "description": "Model ID served by the remote ASR endpoint."
          },
          "asr_api_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asr Api Key",
            "description": "Bearer token for the remote ASR endpoint."
          },
          "ocr_base_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ocr Base Url",
            "description": "OpenAI-compatible remote OCR base URL."
          },
          "ocr_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ocr Model",
            "description": "Model ID served by the remote OCR endpoint."
          },
          "ocr_api_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ocr Api Key",
            "description": "Bearer token for the remote OCR endpoint."
          },
          "context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context",
            "description": "ASR context/biasing text (proper nouns, names, domain vocabulary) that helps transcription accuracy. For URL inputs, page metadata (title, description, tags) is appended automatically unless --no-context is set."
          },
          "metadata_context": {
            "type": "boolean",
            "title": "Metadata Context",
            "description": "Automatically build ASR context from URL metadata (title/description/tags) to bias transcription.",
            "default": true
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language",
            "description": "Language code/hint for transcription or OCR, e.g. zh, en, ja."
          },
          "start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start",
            "description": "0-based inclusive start page for OCR PDF inputs."
          },
          "end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End",
            "description": "0-based inclusive end page for OCR PDF inputs."
          },
          "save_original": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Save Original",
            "description": "Optional path to persist downloaded audio from URL processing."
          },
          "cookies": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cookies",
            "description": "Path to Netscape-format cookies file for URL extraction."
          },
          "cookies_from_browser": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cookies From Browser",
            "description": "Browser cookie source for URL extraction, e.g. chrome:default."
          },
          "raw_transcript": {
            "type": "boolean",
            "title": "Raw Transcript",
            "description": "Preserve original subtitle formatting (SRT/VTT timestamps).",
            "default": false
          }
        },
        "type": "object",
        "title": "ProcessRequest",
        "description": "AIMD processing request accepted by synchronous and job APIs."
      },
      "ProcessResponse": {
        "properties": {
          "task_type": {
            "type": "string",
            "enum": [
              "transcript",
              "convert",
              "ocr"
            ],
            "title": "Task Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "markdown": {
            "type": "string",
            "title": "Markdown"
          },
          "asset_base_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Base Uri"
          },
          "chunk_list": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Chunk List"
          },
          "split_header_level": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Split Header Level"
          },
          "platform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Platform"
          },
          "output_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output File"
          },
          "output_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Dir"
          }
        },
        "type": "object",
        "required": [
          "task_type",
          "title",
          "markdown",
          "chunk_list"
        ],
        "title": "ProcessResponse",
        "description": "Backward-compatible synchronous processing response."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "JobEvent": {
        "description": "Monotonic event emitted by a processing job.",
        "example": {
          "cancellation_status": "none",
          "created_at": "2026-08-15T12:00:00Z",
          "current": 2,
          "job_id": "8a41c856-eef8-4c40-99c4-ce3d49760c71",
          "message": "Transcribing segment 2 of 5",
          "sequence": 3,
          "stage": "transcribing",
          "state": "running",
          "total": 5
        },
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "cancelled"
            ],
            "title": "State",
            "type": "string"
          },
          "stage": {
            "anyOf": [
              {
                "enum": [
                  "downloading",
                  "extracting",
                  "transcribing",
                  "ocr",
                  "converting",
                  "saving"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stage"
          },
          "current": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Current"
          },
          "total": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Message"
          },
          "cancellation_status": {
            "default": "none",
            "enum": [
              "none",
              "requested",
              "cancelled",
              "completed_after_request"
            ],
            "title": "Cancellation Status",
            "type": "string"
          },
          "sequence": {
            "description": "Per-job SSE event identifier.",
            "minimum": 1,
            "title": "Sequence",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "state",
          "sequence",
          "created_at"
        ],
        "title": "JobEvent",
        "type": "object"
      }
    }
  }
}
